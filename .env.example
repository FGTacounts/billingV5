# ---- Supabase (public — safe to ship to the browser; RLS enforces access) ----
# Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# ---- Supabase service role (server-only — NEVER prefix with NEXT_PUBLIC_) ----
# Powers Manager-only admin actions: creating/editing/deactivating Salesman
# and Warehouse accounts (Settings -> Users). Every route that uses this
# re-verifies the caller's session role is Manager before touching it.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Google Drive (server-only) ----
# Same service account the old Sheets-era app used, now scoped to Drive only
# (no more Sheets access). Used for: product photos (matched by SKU, folder ID
# read from app_settings.product_photos_drive_folder_id), cheque/delivery
# proof photo uploads, and auto-saved Tax Invoice PDFs (both read from
# app_settings.private_uploads_drive_folder_id — not an env var).
#
# RECOMMENDED — paste your whole service account JSON file, base64-encoded:
#   macOS:    base64 -i your-key.json | pbcopy
GOOGLE_CREDENTIALS_BASE64=

# OR the two values separately. Only used if the base64 var is empty.
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# ---- Apple MapKit (server-only) ----
# Route planning runs on Apple Maps. Apple has no equivalent of Google's
# waypoint optimisation, so the app orders stops itself using Apple's ETA
# endpoint — see lib/apple-maps.ts.
#
# Apple Developer -> Certificates, Identifiers & Profiles -> Keys.
# Create a key with "MapKit JS" enabled, download the .p8 ONCE, then:
#   base64 -i AuthKey_XXXXXXXXXX.p8 | pbcopy
# The Key ID is in the filename; the Team ID is under Membership.
APPLE_MAPS_TEAM_ID=your-10-char-team-id
APPLE_MAPS_KEY_ID=your-10-char-key-id
APPLE_MAPS_PRIVATE_KEY_BASE64=base64-of-your-p8-file

# ---- Reading paperwork with AI (server-only, optional) ----
# Google AI Studio key: https://aistudio.google.com/apikey
# Powers two things: the camera scan on a new order (a photo of a written
# order pad becomes order lines) and Products -> Scan invoice (a supplier
# invoice becomes products). Both features hide themselves and explain why
# when this is unset, so leaving it empty costs nothing else.
#
# PRIVACY: on Gemini's free tier Google may use submitted content to improve
# their models, and what goes through here is supplier invoices and customer
# names. Use a paid tier if that matters.
GEMINI_API_KEY=
# Optional model override. Default: gemini-2.5-flash
GEMINI_MODEL=

# ---- Encrypted backups (see scripts/BACKUP-RUNBOOK.md) ----
# Generate with: openssl rand -base64 32
# LOSING THIS MAKES EVERY BACKUP PERMANENTLY UNREADABLE.
BACKUP_PASSPHRASE=a-long-random-passphrase
BACKUP_DRIVE_FOLDER_ID=google-drive-folder-id
